# Set locally before deploying. Account credentials are managed by wrangler login.
CLOUDFLARE_ACCOUNT_ID=

# Build-time only: set true for a separately hosted preview, never for production.
# WEBSITE_NOINDEX=true

# Optional public Umami Cloud website identifier. Unset disables analytics.
# Only indexable production pages on opentig.com send events.
WEBSITE_UMAMI_ID=
