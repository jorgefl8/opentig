{
  "name": "@opentig/cli",
  "version": "0.2.5",
  "description": "Run OpenTig, a free, open-source Git client, on your repository host and access it through a paired browser.",
  "type": "module",
  "main": "dist/server.mjs",
  "bin": {
    "opentig": "dist/bin.mjs"
  },
  "exports": {
    ".": "./dist/server.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify:build": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "trash": "9.0.0",
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "keywords": [
    "git",
    "git-client",
    "local-first",
    "cli",
    "headless"
  ],
  "author": "OpenTig",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jorgefl8/opentig.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/jorgefl8/opentig/issues"
  },
  "homepage": "https://opentig.com/",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "uqr": "0.1.3"
  }
}
