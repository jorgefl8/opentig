{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "opentig-website",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "opentig.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none"
  }
}
