{
  "name": "@opentig/desktop",
  "productName": "OpenTig",
  "version": "0.2.2",
  "description": "A focused, local-first Git desktop client for Windows",
  "main": ".vite/build/main.js",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/start-desktop.mjs",
    "start:web:dev": "npm run build:server && node packages/server/dist/dev.mjs serve",
    "pair:web:dev": "node packages/server/dist/dev.mjs pair",
    "build:server": "npm run build --workspace packages/server",
    "package": "node scripts/package-desktop.mjs package",
    "package:dev": "node scripts/package-dev.mjs package",
    "make:dev": "node scripts/package-dev.mjs make",
    "verify:packaged-trash": "electron scripts/verify-packaged-trash.mjs",
    "verify:packaged-server": "node scripts/verify-packaged-server.mjs",
    "verify:packaged-utility": "electron scripts/verify-packaged-utility.mjs",
    "release:pack:headless": "npm run build:server && node scripts/pack-headless.mjs",
    "release:inspect:headless": "node scripts/inspect-headless.mjs",
    "make": "node scripts/package-desktop.mjs make",
    "test": "vitest run",
    "test:related": "vitest related --run",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run typecheck && npm run lint && npm test && npm run audit:prod",
    "build:desktop": "node scripts/build-desktop.mjs",
    "verify:packaged-desktop": "node scripts/verify-packaged-desktop.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "keywords": [
    "git",
    "electron",
    "desktop",
    "git-client",
    "windows"
  ],
  "author": "OpenTig contributors",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inconsolata": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@pierre/diffs": "^1.5.1",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/langs-precompiled": "4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@tabler/icons-react": "3.48.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^9.2.6",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron-updater": "6.8.9",
    "execa": "^10.0.1",
    "isomorphic-dompurify": "^4.4.0",
    "katex": "0.18.10",
    "marked": "^18.0.14",
    "marked-alert": "^2.1.2",
    "marked-footnote": "^1.4.0",
    "marked-katex-extension": "^5.1.13",
    "mermaid": "^12.1.0",
    "motion": "^14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "^4.5.0",
    "sileo": "^0.1.5",
    "tailwind-merge": "3.7.0",
    "trash": "9.0.0",
    "tw-animate-css": "1.4.0",
    "uiohook-napi": "1.5.5",
    "uqr": "0.1.3",
    "which-command": "^0.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@electron/fuses": "2.1.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "43.7.9",
    "electron-builder": "26.15.3",
    "oxc-parser": "0.153.0",
    "oxlint": "1.87.0",
    "shadcn": "^4.21.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "uiohook-napi@1.5.5": true
  }
}
