---
import Layout from '@/layouts/Layout.astro';
import FaultyTerminal from '@/components/FaultyTerminal.astro';
import Navbar from '@/components/landing/navbar.astro';
import PlatformDetect from '@/components/landing/PlatformDetect.astro';
import Hero from '@/components/landing/Hero.astro';
import ProductDemo from '@/components/landing/ProductDemo.astro';
import Features from '@/components/landing/Features.astro';
import Providers from '@/components/landing/Providers.astro';
import PullRequests from '@/components/landing/PullRequests.astro';
import Anywhere from '@/components/landing/Anywhere.astro';
import Cta from '@/components/landing/Cta.astro';
import Faq from '@/components/landing/Faq.astro';
import Footer from '@/components/landing/Footer.astro';
import { installationPath } from '@/docs';
import { indexable } from '@/indexing';
import { repositoryUrl, downloadUrl, npmUrl, siteDescription } from '@/site';

const homeUrl = Astro.site ? new URL('/', Astro.site).href : undefined;
const structuredData = homeUrl && indexable ? {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${homeUrl}#website`,
      name: 'OpenTig',
      url: homeUrl,
      inLanguage: 'en',
      about: { '@id': `${homeUrl}#application` },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${homeUrl}#application`,
      name: 'OpenTig',
      url: homeUrl,
      description: siteDescription,
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'Git client',
      operatingSystem: ['Windows', 'Linux', 'macOS'],
      softwareRequirements: 'Git is required on the repository host. The desktop installer is for Windows 10 or later (x64). The CLI server runs on Windows, Linux, and macOS with Node.js 24 or later. Browser access requires a running OpenTig instance on the repository host and browser pairing.',
      license: `${repositoryUrl}/blob/main/LICENSE`,
      isAccessibleForFree: true,
      sameAs: [repositoryUrl, npmUrl],
      installUrl: new URL(installationPath, homeUrl).href,
      offers: {
        '@type': 'Offer',
        price: 0,
        priceCurrency: 'USD',
        url: downloadUrl,
      },
    },
  ],
} : undefined;
---

<Layout markdown="/index.md" fullBleed>
  {structuredData && <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
  <div class="landing-page relative min-h-screen text-foreground scroll-smooth">
    <div class="fixed inset-0 z-0" data-site-backdrop>
      <FaultyTerminal />
    </div>
    <div class="relative z-10">
      <a href="#main-content" class="skip-link">Skip to content</a>
      <PlatformDetect />
      <Navbar />
      <main id="main-content" tabindex="-1">
        <Hero />
        <ProductDemo />
        <Features />
        <PullRequests />
        <Providers />
        <Anywhere />
        <Faq />
        <Cta />
      </main>
      <Footer />
    </div>
  </div>
</Layout>

<script>
  // Keep the animated backdrop vivid behind the hero and the closing installation section,
  // and nearly hidden behind the dense content between them.
  const backdrop = document.querySelector<HTMLElement>('[data-site-backdrop]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const install = document.querySelector<HTMLElement>('[data-install]');
  if (backdrop && hero) {
    let frame = 0;
    const clamp = (value: number) => Math.min(1, Math.max(0, value));
    const update = () => {
      frame = 0;
      const end = hero.offsetHeight;
      const leaving = clamp((scrollY - end * 0.35) / (end * 0.5));
      const arriving = install ? clamp((innerHeight - install.getBoundingClientRect().top) / (innerHeight * 0.7)) : 0;
      backdrop.style.opacity = String(Math.max(1 - leaving * 0.9, 0.1 + arriving * 0.65));
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule);
    update();
  }
</script>
