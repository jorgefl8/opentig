---

<section id="features" tabindex="-1" class="py-24 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="font-['GeistPixelTriangle'] text-3xl md:text-4xl font-bold tracking-tight">
        Review diffs, edit files, and manage Git
      </h2>
      <p class="text-muted-foreground mt-4 max-w-xl mx-auto">
        Browse your repository, prepare commits, and work with branches, worktrees, and GitHub pull requests.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((feature) => (
        <div class="ring-foreground/10 bg-card text-card-foreground flex flex-col gap-4 overflow-hidden rounded-xl py-4 text-sm ring-1 backdrop-blur-sm border-border/50 hover:border-primary/30 transition-colors">
          <div class="grid auto-rows-min items-start gap-1 rounded-t-xl px-4">
            <div class="mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" class="text-primary" set:html={feature.icon} />
            </div>
            <h3 class="text-base leading-snug font-medium">{feature.title}</h3>
            <div class="text-muted-foreground text-sm">{feature.description}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
