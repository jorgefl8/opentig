---
import WindowsIcon from '@/assets/icons/windows.svg';
import GithubIcon from '@tabler/icons/outline/brand-github.svg';
import Button from './Button.astro';

import { repositoryUrl, downloadUrl, docsUrl } from '@/site';
---

<section class="py-24 px-6">
  <div class="max-w-3xl mx-auto">
    <div class="bg-card/30 backdrop-blur-sm border border-border/50 rounded-2xl p-8 md:p-12 text-center">
      <h2 class="font-['GeistPixelTriangle'] text-3xl md:text-4xl font-bold tracking-tight">
        Ready to <span class="text-primary">review your changes</span>?
      </h2>
      <p class="text-muted-foreground mt-4 max-w-lg mx-auto">
        Bring your files, diffs, and Git controls together. Install the Windows app,
        or set up the OpenTig server with the CLI.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center mt-8">
        <Button href={downloadUrl}>
          <WindowsIcon width={20} height={20} />
          Download for Windows
        </Button>
        <Button href={repositoryUrl} variant="outline" target="_blank" rel="noreferrer">
          <GithubIcon width={20} height={20} />
          View on GitHub
        </Button>
      </div>
      <div class="mt-6 text-sm text-muted-foreground">
        <p>Start a local OpenTig server with Node.js 24+ and Git:</p>
        <code class="inline-block mt-3 max-w-full break-all rounded-lg border border-border/50 bg-background px-4 py-3 font-mono text-foreground">npx --yes @opentig/cli@latest</code>
        <p class="mt-3">Keep the server running and pair your browser to access repositories on that machine.</p>
        <p class="mt-4"><a href={`${docsUrl}/getting-started.md`} class="underline underline-offset-4 hover:text-foreground">Installation guide</a>{" · "}Early development{" · "}Windows installer currently unsigned</p>
      </div>
    </div>
  </div>
</section>
