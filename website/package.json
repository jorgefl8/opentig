{
  "name": "@opentig/website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro sync && node scripts/check.mjs && oxlint . && node --test scripts/*.test.mjs",
    "deploy": "npm run check && npm run build && wrangler deploy",
    "deploy:www": "npm run check && wrangler deploy --config wrangler.www.jsonc"
  },
  "dependencies": {
    "astro": "7.3.8",
    "cookie": "2.0.1",
    "ogl": "1.0.11"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tabler/icons": "3.49.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "oxlint": "1.88.0",
    "parse5": "8.0.1",
    "saxes": "6.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "wrangler": "4.151.0"
  }
}
