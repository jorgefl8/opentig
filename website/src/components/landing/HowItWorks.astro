---
const steps = [
  {
    number: "01",
    title: "Choose your workspace",
    description: "Install the Windows app, or start the CLI with Node.js 24+ and Git. Both give you the same focused workspace.",
  },
  {
    number: "02",
    title: "Open a repository",
    description: "Choose an existing repository on the host. Browse files, inspect history, and see your working changes.",
  },
  {
    number: "03",
    title: "Review & commit",
    description: "Edit what needs changing, stage what belongs together, and create the commit you intended.",
  },
];
---

<section id="how-it-works" class="py-24 px-6">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="font-['GeistPixelTriangle'] text-3xl md:text-4xl font-bold tracking-tight">
        Up and running in minutes
      </h2>
      <p class="text-muted-foreground mt-4 max-w-xl mx-auto">
        Three simple steps from your repository to your next commit.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {steps.map((step) => (
        <div class="ring-foreground/10 bg-card text-card-foreground flex flex-col gap-4 overflow-hidden rounded-xl py-4 text-sm ring-1 backdrop-blur-sm border-border/50 hover:border-primary/30 transition-colors">
          <div class="grid auto-rows-min items-start gap-1 rounded-t-xl px-4">
            <span class="font-['GeistPixelTriangle'] text-2xl text-primary mb-1">
              {step.number}
            </span>
            <div class="text-base leading-snug font-medium">{step.title}</div>
            <div class="text-muted-foreground text-sm">{step.description}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
