{
  "name": "justgit",
  "productName": "JustGit",
  "version": "0.1.0",
  "description": "A focused, local-first Git desktop client for Windows",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run typecheck && npm run lint && npm test && npm run audit:prod"
  },
  "keywords": [
    "git",
    "electron",
    "desktop",
    "git-client",
    "windows"
  ],
  "author": "JustGit contributors",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@opencode-ai/sdk": "1.15.13",
    "@pierre/diffs": "^1.3.5",
    "@shikijs/langs": "^4.3.0",
    "@shikijs/langs-precompiled": "4.3.0",
    "@shikijs/themes": "^4.3.0",
    "@tabler/icons-react": "3.45.0",
    "@tanstack/react-virtual": "^3.14.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cross-spawn": "7.0.6",
    "electron-squirrel-startup": "1.0.1",
    "isomorphic-dompurify": "^3.18.0",
    "katex": "^0.17.0",
    "marked": "^18.0.5",
    "marked-alert": "^2.1.2",
    "marked-footnote": "^1.4.0",
    "marked-katex-extension": "^5.1.10",
    "mermaid": "^11.16.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shiki": "^4.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "uiohook-napi": "1.5.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "10.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/cross-spawn": "6.0.6",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "43.1.1",
    "eslint": "10.0.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.3.0",
    "shadcn": "^4.13.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "typescript-eslint": "8.65.0",
