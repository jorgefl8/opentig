{
  "name": "@opentig/desktop",
  "productName": "OpenTig",
  "version": "0.1.0",
  "description": "A focused, local-first Git desktop client for Windows",
  "main": ".vite/build/main.js",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/start-desktop.mjs",
    "start:web:dev": "npm run build:server && node packages/server/dist/dev.mjs serve",
    "pair:web:dev": "node packages/server/dist/dev.mjs pair",
    "build:server": "npm run build --workspace packages/server",
    "package": "node scripts/package-desktop.mjs package",
    "package:dev": "node scripts/package-dev.mjs package",
    "make:dev": "node scripts/package-dev.mjs make",
    "verify:packaged-trash": "electron scripts/verify-packaged-trash.mjs",
    "verify:packaged-server": "node scripts/verify-packaged-server.mjs",
    "verify:packaged-utility": "electron scripts/verify-packaged-utility.mjs",
    "release:pack:headless": "npm run build:server && node scripts/pack-headless.mjs",
    "release:inspect:headless": "node scripts/inspect-headless.mjs",
    "make": "node scripts/package-desktop.mjs make",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run typecheck && npm run lint && npm test && npm run audit:prod",
    "build:desktop": "node scripts/build-desktop.mjs",
    "verify:packaged-desktop": "node scripts/verify-packaged-desktop.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "keywords": [
    "git",
    "electron",
    "desktop",
    "git-client",
    "windows"
  ],
  "author": "OpenTig contributors",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inconsolata": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@opencode-ai/sdk": "1.15.13",
    "@pierre/diffs": "^1.3.5",
    "@shikijs/langs": "^4.3.0",
    "@shikijs/langs-precompiled": "4.3.0",
    "@shikijs/themes": "^4.3.0",
    "@tabler/icons-react": "3.45.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron-updater": "6.8.9",
    "execa": "^10.0.1",
    "isomorphic-dompurify": "^3.18.0",
    "katex": "^0.17.0",
    "marked": "^18.0.5",
    "marked-alert": "^2.1.2",
    "marked-footnote": "^1.4.0",
    "marked-katex-extension": "^5.1.10",
    "mermaid": "^11.16.1",
    "motion": "^12.43.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shiki": "^4.3.0",
    "sileo": "^0.1.5",
    "tailwind-merge": "3.6.0",
    "trash": "10.1.1",
    "tw-animate-css": "1.4.0",
    "uiohook-napi": "1.5.5",
    "uqr": "0.1.3",
    "which-command": "^0.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "4.1.9",
    "yaml": "2.9.1"
  }
}
