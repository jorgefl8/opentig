---
/**
 * Pure Astro FaultyTerminal: zero-framework WebGL background.
 * Config baked in from the landing page usage. No React needed.
 */
---

<div id="faulty-terminal" class="w-full h-full relative overflow-hidden" style="contain:strict" aria-hidden="true"></div>

<script>
  import { Renderer, Program, Mesh, Triangle } from 'ogl';

  const VERTEX = `
attribute vec2 position;
attribute vec2 uv;
varying vec2 vUv;
void main(){
  vUv = uv;
  gl_Position = vec4(position,0.0,1.0);
}`;

  // Stripped shader: no mouse, no chromatic aberration, no dither,
  // no scanlines, no page-load animation.
  const FRAGMENT = `
precision mediump float;

varying vec2 vUv;

uniform float iTime;

// Precomputed per-frame
uniform float uNoiseFactor;
uniform mat2  uRotFbm0;
uniform mat2  uRotPattern;

// Constants baked from config
const float SCALE       = 2.4;
const vec2  GRID_MUL    = vec2(2.0, 1.0);
const float DIGIT_SIZE  = 1.6;
const float NOISE_AMP   = 0.7;
const float GLITCH_AMT  = 1.0;
const float FLICKER_AMT = 1.0;
const float CURVATURE   = 0.26;
const vec3  TINT        = vec3(0.12549, 0.12549, 0.12549);
const float BRIGHTNESS  = 1.2;

const mat2 ROT_01 = mat2(0.99500417, -0.09983342, 0.09983342, 0.99500417);

float time;

float noise(vec2 p){
  return sin(p.x*10.0)*sin(p.y*(3.0+uNoiseFactor))+0.2;
}

float fbm(vec2 p){
  p *= 1.1;
  float amp = 0.5 * NOISE_AMP;
  float f = amp * noise(p);
  p = uRotFbm0 * p * 2.0;
  amp *= 0.454545;
  f += amp * noise(p);
  p = uRotFbm0 * p * 2.0;
  amp *= 0.454545;
  f += amp * noise(p);
  return f;
}

float pattern(vec2 p, out vec2 q, out vec2 r){
  vec2 o1 = vec2(1.0), o0 = vec2(0.0);
  q = vec2(fbm(p+o1), fbm(uRotPattern*p+o1));
  r = vec2(fbm(ROT_01*q+o0), fbm(q+o0));
  return fbm(p+r);
}

float digit(vec2 p){
  vec2 grid = GRID_MUL * 15.0;
  vec2 s = floor(p*grid)/grid;
  p = p*grid;
  vec2 q, r;
  float intensity = pattern(s*0.1, q, r)*1.3 - 0.03;

  p = fract(p) * DIGIT_SIZE;
  float px5 = p.x*5.0;
  float py5 = (1.0-p.y)*5.0;
  float x = fract(px5);
  float y = fract(py5);
  float i = floor(py5)-2.0;
  float j = floor(px5)-2.0;
  float f = (i*i+j*j)*0.0625;
  float isOn = step(0.1, intensity-f);
  float br = isOn*(0.2+y*0.8)*(0.75+x*0.25);
  return step(0.0,p.x)*step(p.x,1.0)*step(0.0,p.y)*step(p.y,1.0)*br;
}

float onOff(float a, float b, float c){
  return step(c, sin(iTime+a*cos(iTime*b)))*FLICKER_AMT;
}

float displace(vec2 look){
  float y = look.y - mod(iTime*0.25,1.0);
  float w = 1.0/(1.0+50.0*y*y);
  return sin(look.y*20.0+iTime)*0.0125*onOff(4.0,2.0,0.8)*(1.0+cos(iTime*60.0))*w;
}

vec3 getColor(vec2 p){
  float displacement = displace(p);
  p.x += displacement;

  float middle = digit(p);

  const float off = 0.002;
  float sum = digit(p+vec2(0.0,-off))
            + digit(p+vec2(-off,0.0)) + middle + digit(p+vec2(off,0.0))
            + digit(p+vec2(0.0, off));

  return vec3(0.9)*middle + sum*0.18;
}

vec2 barrel(vec2 uv){
  vec2 c = uv*2.0-1.0;
  c *= 1.0 + CURVATURE*dot(c,c);
  return c*0.5+0.5;
}

void main(){
  time = iTime*0.333333;
  vec2 uv = barrel(vUv);
  vec2 p = uv*SCALE;
  vec3 col = getColor(p)*TINT*BRIGHTNESS;
  gl_FragColor = vec4(col,1.0);
}`;

  // ── Boot ──────────────────────────────────────────────────
  function initializeTerminal() {
    const element = document.getElementById('faulty-terminal');
    if (!element) return;
    const ctn: HTMLElement = element;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const frameInterval = 1000 / 30;
    const maxPixels = 2_000_000;
    let frame = 0;
    let lastDraw = -Infinity;
    let sceneTime = performance.now();
    let needsDraw = true;
    let contextLost = false;
    let pageActive = true;
    let width = 0;
    let height = 0;
    // A single full-screen triangle does not need a depth buffer.
    const renderer = new Renderer({ depth: false });
    const gl = renderer.gl;
    gl.clearColor(0, 0, 0, 1);

    const geometry = new Triangle(gl);

    const ID = new Float32Array([1, 0, 0, 1]);

    const program = new Program(gl, {
      vertex: VERTEX,
      fragment: FRAGMENT,
      depthTest: false,
      depthWrite: false,
      uniforms: {
        iTime:        { value: 0 },
        uNoiseFactor: { value: 0 },
        uRotFbm0:     { value: new Float32Array(ID) },
        uRotPattern:  { value: new Float32Array(ID) },
      },
    });

    const mesh = new Mesh(gl, { geometry, program });

    // ── Resize ────────────────────────────────────────────────
    function resize() {
      const nextWidth = ctn.offsetWidth;
      const nextHeight = ctn.offsetHeight;
      if (!nextWidth || !nextHeight) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5, Math.sqrt(maxPixels / (nextWidth * nextHeight)));
      if (width === nextWidth && height === nextHeight && renderer.dpr === dpr) return;
      width = nextWidth;
      height = nextHeight;
      renderer.dpr = dpr;
      renderer.setSize(width, height);
      needsDraw = true;
      // Resizing clears the buffer, including when reduced motion stops the loop.
      restart();
    }

    const ro = new ResizeObserver(resize);
    ctn.appendChild(gl.canvas);

    // ── Animation loop ────────────────────────────────────────
    const timeOffset = Math.random() * 100;

    function draw(t: number) {
      const elapsed = (t * 0.001 + timeOffset); // timeScale = 1
      program.uniforms.iTime.value = elapsed;

      const inner = elapsed * 0.333333;
      program.uniforms.uNoiseFactor.value = Math.sin(inner * 0.090909);

      const a0 = inner * 0.02;
      const c0 = Math.cos(a0), s0 = Math.sin(a0);
      const r0 = program.uniforms.uRotFbm0.value as Float32Array;
      r0[0] = c0; r0[1] = -s0; r0[2] = s0; r0[3] = c0;

      const ap = 0.1 * inner;
      const cp = Math.cos(ap), sp = Math.sin(ap);
      const rp = program.uniforms.uRotPattern.value as Float32Array;
      rp[0] = cp; rp[1] = -sp; rp[2] = sp; rp[3] = cp;

      renderer.render({ scene: mesh });
    }

    function update(t: number) {
      frame = 0;
      if (document.hidden || !pageActive || contextLost) return;
      if (needsDraw || (!motion.matches && t - lastDraw >= frameInterval - 0.5)) {
        if (!motion.matches) sceneTime = t;
        draw(sceneTime);
        needsDraw = false;
        // Preserve the cadence on screens whose refresh rate is not a multiple of 30.
        lastDraw = Number.isFinite(lastDraw) ? t - (Math.max(0, t - lastDraw - frameInterval) % frameInterval) : t;
      }
      if (!motion.matches) frame = requestAnimationFrame(update);
    }

    function restart() {
      cancelAnimationFrame(frame);
      frame = 0;
      if (!document.hidden && pageActive && !contextLost) frame = requestAnimationFrame(update);
    }
    function hidePage() {
      pageActive = false;
      restart();
    }
    function showPage() {
      pageActive = true;
      resize();
      restart();
    }
    function loseContext(event: Event) {
      event.preventDefault();
      contextLost = true;
      restart();
    }
    function restoreContext() {
      cancelAnimationFrame(frame);
      ro.disconnect();
      motion.removeEventListener('change', restart);
      document.removeEventListener('visibilitychange', restart);
      window.removeEventListener('resize', resize);
      window.removeEventListener('pagehide', hidePage);
      window.removeEventListener('pageshow', showPage);
      gl.canvas.removeEventListener('webglcontextlost', loseContext);
      gl.canvas.removeEventListener('webglcontextrestored', restoreContext);
      geometry.remove();
      program.remove();
      gl.canvas.remove();
      // OGL does not rebuild GPU resources after a context loss.
      startTerminal();
    }
    motion.addEventListener('change', restart);
    document.addEventListener('visibilitychange', restart);
    window.addEventListener('resize', resize);
    window.addEventListener('pagehide', hidePage);
    window.addEventListener('pageshow', showPage);
    gl.canvas.addEventListener('webglcontextlost', loseContext);
    gl.canvas.addEventListener('webglcontextrestored', restoreContext);
    ro.observe(ctn);
    resize();
  }

  function startTerminal() {
    try {
      initializeTerminal();
    } catch (error) {
      // The page remains readable on its black background without WebGL.
      console.warn('The decorative terminal background is unavailable.', error);
    }
  }
  startTerminal();
</script>
