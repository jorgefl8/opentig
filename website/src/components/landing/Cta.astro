---
import { installationPath } from '@/docs';
import WindowsIcon from '@/assets/icons/windows.svg';
import Button from './Button.astro';
import CopyCommand from './CopyCommand.astro';
import SmartScreenNotice from './SmartScreenNotice.astro';
import InstallerScan from './InstallerScan.astro';
import SectionHeading from './SectionHeading.astro';

import { downloadUrl, downloadVersion, npmUrl } from '@/site';
---

<section id="install" data-install class="px-4 sm:px-6 py-28 scroll-mt-20" aria-labelledby="install-heading">
  <div class="max-w-5xl mx-auto">
    <SectionHeading id="install-heading" lead="Your repositories, your machine." detail="Free and open source." />

    <div class="tile-grid mt-12 md:grid-cols-2 backdrop-blur-sm">
      <div class="tile bg-card/85! p-6 sm:p-8 gap-4">
        <p class="eyebrow">On Windows</p>
        <h3 class="flex items-center gap-2 text-xl font-medium"><WindowsIcon width={20} height={20} />Download the app.</h3>
        <p class="text-sm text-muted-foreground leading-relaxed">Windows 10 or later (x64), with Git installed. The app includes the OpenTig server.</p>
        <div class="mt-auto flex flex-col gap-2 pt-2">
          <Button href={downloadUrl} data-windows-download data-analytics-placement="install" class="self-start px-5!">Download for Windows</Button>
          <SmartScreenNotice align="start" />
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted-foreground">
            <span data-release-version class="font-mono">{downloadVersion}</span>
            <InstallerScan id="install-installer-scan" />
          </div>
        </div>
      </div>
      <div class="tile bg-card/85! p-6 sm:p-8 gap-4">
        <p class="eyebrow">On any host</p>
        <h3 class="text-xl font-medium">Install the CLI server.</h3>
        <p class="text-sm text-muted-foreground leading-relaxed">Linux, macOS, or Windows, with Node.js 24+ and Git. It keeps running in the background on the machine with your repositories.</p>
        <CopyCommand />
        <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2 pt-2">
          <Button href={`${installationPath}#run-the-headless-cli`} data-analytics-placement="install-cli" variant="outline" class="px-4!">Set up OpenTig CLI</Button>
          <a href={npmUrl} class="font-mono text-xs text-muted-foreground underline underline-offset-4 hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary">View on npm <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
    <p class="mt-6 text-sm text-muted-foreground leading-relaxed">
      Both can serve a paired browser while they keep running.
      <a href="/docs/web-access/" class="underline underline-offset-4 hover:text-foreground">Browser access guide</a>
      {' · '}
      <a href={installationPath} class="underline underline-offset-4 hover:text-foreground">Full installation guide</a>
      {' · '}Early development
    </p>
  </div>
</section>
