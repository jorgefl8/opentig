---
import WindowsIcon from '@/assets/icons/windows.svg';
import GithubIcon from '@tabler/icons/outline/brand-github.svg';
import { cliInstallCommand, repositoryUrl, downloadUrl, downloadVersion } from '@/site';
import Button from './Button.astro';
import CopyCommand from './CopyCommand.astro';
import InstallerScan from './InstallerScan.astro';
import HeroTypewriter from './HeroTypewriter';

const platforms = [
  { id: 'windows', label: 'Windows' },
  { id: 'macos', label: 'macOS' },
  { id: 'linux', label: 'Linux' },
];
---

<section data-hero class="relative flex items-center justify-center overflow-hidden">
  <div class="relative z-10 w-full max-w-4xl mx-auto text-center px-6 pt-28 pb-10 md:pt-32">
    <h1 aria-label="A focused workspace for your Git repositories." class="font-['GeistPixelTriangle'] text-4xl sm:text-5xl md:text-7xl font-bold tracking-tight leading-[1.1]">
      <span class="hero-title-intro">A focused workspace</span>
      <span class="hero-title-line"><span>for your</span><HeroTypewriter client:load /></span>
    </h1>

    <p class="text-base md:text-lg text-muted-foreground max-w-2xl mx-auto mt-6 leading-relaxed">
      Browse files, review diffs, make edits, and commit changes.
      Work with branches, worktrees, and GitHub pull requests from the same interface.
    </p>

    <div data-platform-only="windows" class="flex flex-col sm:flex-row gap-3 justify-center mt-10">
      <Button href={downloadUrl} data-windows-download data-analytics-placement="hero">
        <WindowsIcon width={20} height={20} />
        Download for Windows
      </Button>
      <Button href={repositoryUrl} variant="outline" target="_blank" rel="noreferrer">
        <GithubIcon width={20} height={20} />
        View on GitHub
      </Button>
    </div>

    <div data-platform-only="cli" class="mx-auto mt-10 max-w-xl">
      <CopyCommand compact emphasis command={cliInstallCommand} placement="hero" />
      <div class="mt-3 flex flex-col items-center justify-center gap-x-4 gap-y-2 text-sm text-muted-foreground sm:flex-row">
        <p>Runs in the background and adds the <code class="font-mono text-foreground">opentig</code> command.</p>
        <Button href={repositoryUrl} variant="outline" size="sm" target="_blank" rel="noreferrer">
          <GithubIcon width={16} height={16} />
          View on GitHub
        </Button>
      </div>
    </div>

    <div class="mt-4 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 font-mono text-xs text-muted-foreground">
      <span data-release-version>{downloadVersion}</span>
      <span aria-hidden="true">·</span>
      <span>Free &amp; open source</span>
      <span data-platform-only="windows" class="contents"><span aria-hidden="true" class="hidden sm:inline">·</span><InstallerScan id="hero-installer-scan" /></span>
      <span data-platform-only="cli" class="contents"><span aria-hidden="true" class="hidden sm:inline">·</span><span>Requires Node.js 24+ and Git</span></span>
    </div>

    <div data-platform-picker role="group" aria-label="Installation platform" class="mt-6 inline-flex rounded-full border border-border/60 bg-background/70 p-[3px] text-xs">
      {platforms.map(platform => (
        <button type="button" data-platform-option={platform.id} aria-pressed="false"
          class="min-h-7 rounded-full px-3 text-muted-foreground hover:text-foreground aria-pressed:bg-white/10 aria-pressed:font-semibold aria-pressed:text-foreground focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-primary">{platform.label}</button>
      ))}
    </div>
    <p data-platform-status role="status" class="sr-only"></p>
    <noscript><p class="mt-4 text-xs text-muted-foreground">On macOS or Linux, <a href="#install" class="underline underline-offset-4">install the CLI</a>.</p></noscript>
  </div>
</section>

<script>
  const labels: Record<string, string> = { windows: 'Windows', macos: 'macOS', linux: 'Linux' };
  const options = document.querySelectorAll<HTMLButtonElement>('[data-platform-option]');
  const status = document.querySelector('[data-platform-status]');
  const sync = () => {
    const current = document.documentElement.dataset.platform;
    options.forEach(option => option.setAttribute('aria-pressed', String(option.dataset.platformOption === current)));
  };
  options.forEach(option => option.addEventListener('click', () => {
    const platform = option.dataset.platformOption!;
    document.documentElement.dataset.platform = platform;
    sync();
    if (status) status.textContent = `Showing the ${labels[platform]} installation.`;
  }));
  sync();
</script>
