---
import LogoLoop from '@/components/LogoLoop.astro';
import ClaudeCodeSvg from '@/assets/icons/claude-code.svg';
import CodexSvg from '@/assets/icons/codex.svg';
import GitSvg from '@tabler/icons/outline/brand-git.svg';
import GithubSvg from '@tabler/icons/outline/brand-github.svg';
import OpenCodeSvg from '@/assets/icons/opencode.svg';
import GrokSvg from '@/assets/icons/grok.svg';
import SectionHeading from './SectionHeading.astro';
import Shot from './Shot.astro';

---

<section id="tools" class="pt-20 pb-12" aria-labelledby="tools-heading">
  <div class="px-4 sm:px-6"><div class="max-w-5xl mx-auto">
    <SectionHeading id="tools-heading" lead="Optional AI. You confirm every commit." detail="Bring the AI CLI you already use." />

    <div class="tile-grid tile-grid-ai mt-12">
      <div class="tile ai-points">
        <article class="ai-point">
          <h3><span>Commit splitting.</span> <span class="section-heading-detail">Mixed several tasks into your staged changes? Get groups of complete files, each with a message and a reason.</span></h3>
          <ol class="ai-steps">
            <li><span aria-hidden="true">01</span>Review the proposed groups and their diffs.</li>
            <li><span aria-hidden="true">02</span>Prepare one group in the staging area.</li>
            <li><span aria-hidden="true">03</span>Create its commit, then continue with the next.</li>
          </ol>
        </article>
        <article class="ai-point">
          <h3><span>Commit messages.</span> <span class="section-heading-detail">Draft a subject and body from your staged changes, then edit the wording.</span></h3>
        </article>
        <article class="ai-point">
          <h3><span>Pull request descriptions.</span> <span class="section-heading-detail">Draft a title and description from your branch changes. You decide when to publish.</span></h3>
        </article>
      </div>
      <div class="tile">
        <div class="tile-stage has-shot flex-1">
          <Shot name="split" alt="A suggested commit plan with two commits, each with its message, reason, and files, above the generated commit message." />
        </div>
      </div>
    </div>

    <p class="mt-5 text-sm text-muted-foreground leading-relaxed">
      Uses a supported, signed-in AI CLI on the host. Everyday Git work needs no AI account.
      <a href="/docs/ai-assistance/" class="inline-block underline underline-offset-4 hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary">Explore AI assistance</a>
    </p>
    <h3 class="mt-16 mb-4 text-center text-xl md:text-2xl font-semibold tracking-tight text-foreground">Your Git tools. Your choice of AI.</h3>
  </div></div>

  <div class="h-12 relative overflow-hidden text-white">
    <LogoLoop
      logos={[
        { Svg: GitSvg, alt: "Git", label: "Git" },
        { Svg: GithubSvg, alt: "GitHub", label: "GitHub" },
        { Svg: ClaudeCodeSvg, alt: "Claude Code", label: "Claude Code" },
        { Svg: CodexSvg, alt: "Codex", label: "Codex" },
        { Svg: OpenCodeSvg, alt: "OpenCode", label: "OpenCode" },
        { Svg: GrokSvg, alt: "Grok Build", label: "Grok Build" },
      ]}
      speed={25}
      logoHeight={32}
      gap={48}
    />
  </div>
</section>
