{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "opentig-website",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "opentig.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only pages with a Markdown twin need content negotiation.
    "run_worker_first": ["/", "/docs/*"]
  }
}
