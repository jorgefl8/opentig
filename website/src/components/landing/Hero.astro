---
import WindowsIcon from '@/assets/icons/windows.svg';
import GithubIcon from '@tabler/icons/outline/brand-github.svg';
import GitLogo from '@tabler/icons/outline/brand-git.svg';
import BrowserLogo from '@tabler/icons/outline/browser.svg';
import { repositoryUrl, downloadUrl, downloadVersion } from '@/site';
import Button from './Button.astro';
import CopyCommand from './CopyCommand.astro';
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <div class="relative z-10 max-w-4xl mx-auto text-center px-6 py-24">
    <h1 class="font-['GeistPixelTriangle'] text-4xl sm:text-5xl md:text-7xl font-bold tracking-tight leading-[1.1]">
      A focused workspace{" "}
      <br class="hidden sm:block" />
      for your <span class="text-primary-heading">Git repositories.</span>
    </h1>

    <p class="text-base md:text-lg text-muted-foreground max-w-2xl mx-auto mt-6 leading-relaxed">
      Browse files, review diffs, make edits, and commit changes.
      Work with branches, worktrees, and GitHub pull requests from the same interface.
    </p>

    <p class="text-sm text-muted-foreground max-w-xl mx-auto mt-4 leading-relaxed">
      Optional AI assistance for commit messages, commit splitting, and pull request descriptions.
    </p>

    <div class="flex items-center justify-center gap-5 sm:gap-8 flex-wrap mt-6 text-muted-foreground text-sm">
      <span class="inline-flex items-center gap-2"><GitLogo width={20} height={20} /> Git</span>
      <span class="inline-flex items-center gap-2"><GithubIcon width={20} height={20} /> GitHub</span>
      <span class="inline-flex items-center gap-2"><BrowserLogo width={20} height={20} /> Browser</span>
      <span class="text-muted-foreground italic">and more…</span>
    </div>

    <div class="flex flex-col sm:flex-row gap-3 justify-center sm:items-start mt-10">
      <Button href={downloadUrl} data-windows-download data-analytics-placement="hero">
        <WindowsIcon width={20} height={20} />
        Download for Windows
      </Button>
      <Button href={repositoryUrl} variant="outline" target="_blank" rel="noreferrer">
        <GithubIcon width={20} height={20} />
        View on GitHub
      </Button>
    </div>
    <p class="mt-3 flex flex-wrap items-center justify-center gap-x-2 font-mono text-xs text-muted-foreground">
      <span data-release-version>{downloadVersion}</span>
      <span aria-hidden="true">·</span>
      <span>Free &amp; open source</span>
    </p>
    <div class="mx-auto mt-6 max-w-md">
      <p class="mb-3 text-xs text-muted-foreground">or</p>
      <CopyCommand compact command="npm install -g @opentig/cli" placement="hero" />
    </div>

  </div>
</section>
