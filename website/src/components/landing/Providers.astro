---
import LogoLoop from '@/components/LogoLoop.astro';
import ClaudeCodeSvg from '@/assets/icons/claude-code.svg';
import CodexSvg from '@/assets/icons/codex.svg';
import GitSvg from '@tabler/icons/outline/brand-git.svg';
import GithubSvg from '@tabler/icons/outline/brand-github.svg';
import TerminalSvg from '@tabler/icons/outline/terminal-2.svg';
import BrowserSvg from '@tabler/icons/outline/browser.svg';
---

<section id="tools" class="py-24">
  <div class="max-w-7xl mx-auto px-6 text-center mb-16">
    <h2 class="font-['GeistPixelTriangle'] text-3xl md:text-4xl font-bold tracking-tight">
      Git, GitHub, and optional AI assistance
    </h2>
    <p class="text-muted-foreground mt-4 max-w-xl mx-auto">
      Use Git installed on your machine and connect GitHub through its CLI.
      Add AI assistance through a supported, authenticated CLI when you want it.
      Everyday Git work needs no AI account.
    </p>
  </div>

  <div class="h-20 relative overflow-hidden text-white">
    <LogoLoop
      logos={[
        { Svg: GitSvg, alt: "Git", label: "Git" },
        { Svg: GithubSvg, alt: "GitHub", label: "GitHub" },
        { Svg: ClaudeCodeSvg, alt: "Claude Code", label: "Claude Code" },
        { Svg: CodexSvg, alt: "Codex", label: "Codex" },
        { Svg: TerminalSvg, alt: "CLI", label: "CLI" },
        { Svg: BrowserSvg, alt: "Browser", label: "Browser" },
      ]}
      speed={25}
      logoHeight={32}
      gap={48}
    />
  </div>
</section>
