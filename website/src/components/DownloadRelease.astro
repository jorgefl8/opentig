<script>
  import { latestDownload } from '@/lib/downloads';
  import { updateRelease } from '@/lib/release-ui';
  if (document.querySelector('[data-windows-download]')) {
    document.querySelectorAll('[data-scan-status]').forEach(label => { label.textContent = 'Checking scan status…'; });
    void latestDownload().then(release => updateRelease(document, release));
  }
</script>
