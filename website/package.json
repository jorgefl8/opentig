{
  "name": "@opentig/website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro sync && node scripts/check.mjs && tsc --project demo/tsconfig.json && oxlint . && node --test scripts/*.test.mjs",
    "deploy": "pnpm run check && pnpm run build && wrangler deploy",
    "predev": "node scripts/build-demo.mjs",
    "prebuild": "node scripts/build-demo.mjs",
    "precheck": "node scripts/build-demo.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/react": "7.1.0",
    "astro": "7.3.8",
    "cookie": "2.0.1",
    "diff": "9.0.0",
    "fumadocs-core": "16.17.3",
    "fumadocs-ui": "16.17.3",
    "motion": "14.0.0",
    "ogl": "1.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tabler/icons": "3.49.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "oxlint": "1.88.0",
    "parse5": "8.0.1",
    "saxes": "6.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "wrangler": "4.151.1"
  }
}
