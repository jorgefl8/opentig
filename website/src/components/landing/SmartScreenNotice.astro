---
import AlertTriangleIcon from '@tabler/icons/outline/alert-triangle.svg';
import { installationPath } from '@/docs';
---

<p class="mx-auto max-w-72 text-center text-xs leading-relaxed text-muted-foreground">
  <AlertTriangleIcon width={14} height={14} aria-hidden="true" class="mr-1 inline-block align-text-bottom text-amber-400" />
  Windows may show a SmartScreen warning.
  <a href={`${installationPath}#windows-smartscreen-warning`} aria-label="Why Windows may show a SmartScreen warning" class="whitespace-nowrap underline underline-offset-4 hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary">Why?</a>
</p>
