---
import Logo from '@/assets/logo.svg';
import { downloadUrl } from '@/site';
import WindowsIcon from '@/assets/icons/windows.svg';
import TerminalIcon from '@tabler/icons/outline/terminal-2.svg';
import Button from './Button.astro';
import GooeyNavigation from './GooeyNavigation';
---

<header class="fixed top-4 left-4 right-4 z-50">
  <div class="max-w-5xl mx-auto px-5 h-12 flex items-center justify-between backdrop-blur-xl bg-background/60 border border-border/50 rounded-xl">
    <a href="/" class="flex items-center gap-2.5">
      <Logo class="h-8 w-8" />
      <span class="font-semibold text-white text-sm">OpenTig</span>
    </a>

    <div class="hidden md:flex items-center">
      <GooeyNavigation client:load />
    </div>

    <Button href={downloadUrl} data-windows-download data-analytics-placement="navbar" data-platform-only="windows" size="sm">
      <WindowsIcon width={16} height={16} />
      Download
    </Button>
    <Button href="#install" data-platform-only="cli" size="sm">
      <TerminalIcon width={16} height={16} />
      Install
    </Button>
  </div>
</header>
