---
import Logo from '@/assets/logo.svg';
import { downloadUrl } from '@/site';
import WindowsIcon from '@/assets/icons/windows.svg';
import TerminalIcon from '@tabler/icons/outline/terminal-2.svg';
import GithubIcon from '@tabler/icons/outline/brand-github.svg';
import { repositoryUrl } from '@/site';
import Button from './Button.astro';
import GooeyNavigation from './GooeyNavigation';
---

<header class="landing-navbar fixed z-50">
  <div class="max-w-5xl mx-auto px-5 h-12 flex items-center justify-between backdrop-blur-xl bg-background/60 border border-border/50 rounded-xl">
    <a href="/" class="flex items-center gap-2.5">
      <Logo class="h-8 w-8" />
      <span class="font-semibold text-white text-sm">OpenTig</span>
    </a>

    <div class="hidden md:flex items-center">
      <GooeyNavigation client:load />
    </div>

    <div class="flex items-center gap-1.5">
    <a href={repositoryUrl} target="_blank" rel="noreferrer" aria-label="OpenTig on GitHub (opens in a new tab)" class="hidden sm:inline-flex h-8 w-8 items-center justify-center rounded-lg text-muted-foreground hover:bg-white/[0.06] hover:text-foreground">
      <GithubIcon width={18} height={18} aria-hidden="true" />
    </a>
    <Button href={downloadUrl} data-windows-download data-analytics-placement="navbar" data-platform-only="windows" size="sm">
      <WindowsIcon width={16} height={16} />
      Download
    </Button>
    <Button href="#install" data-platform-only="cli" size="sm">
      <TerminalIcon width={16} height={16} />
      Install
    </Button>
    </div>
  </div>
</header>
