---
import '@/index.css';
import { indexable } from '@/indexing';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  canonicalPage?: boolean;
}
const {
  title = 'OpenTig | Free, open-source Git client',
  description = 'Browse files, review diffs, edit code, and commit changes. OpenTig brings branches, worktrees, and GitHub pull requests into one focused Git workspace.',
  noindex = false,
  canonicalPage = true,
} = Astro.props;
// Only emit absolute social URLs when a public origin has been configured.
const canonical = canonicalPage && Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImage = Astro.site ? new URL('/opentig-social.png', Astro.site) : undefined;
const socialImageAlt = 'OpenTig, a free, open-source Git client, showing changed files and a side-by-side code diff.';
---

<!DOCTYPE html>
<html lang="en" class="dark" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {(noindex || !indexable) && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#070707" />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OpenTig" />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:type" content="image/png" />}
    {socialImage && <meta property="og:image:width" content="1200" />}
    {socialImage && <meta property="og:image:height" content="630" />}
    {socialImage && <meta property="og:image:alt" content={socialImageAlt} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && <meta name="twitter:image:alt" content={socialImageAlt} />}
    <link rel="preload" href="/fonts/GeistPixel-Triangle.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Inconsolata.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/Geist.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
